{
  "name": "@orcestr/commerce-solana-core",
  "version": "0.2.0",
  "description": "Framework-independent Token-2022 payment contracts and API client for Orcestr Commerce Solana.",
  "author": "Artasov",
  "license": "MPL-2.0",
  "keywords": [
    "commerce",
    "orcestr",
    "payments",
    "solana",
    "token-2022"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Artasov/orcestr-commerce-solana.git",
    "directory": "frontend/packages/core"
  },
  "homepage": "https://github.com/Artasov/orcestr-commerce-solana/tree/main/frontend/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Artasov/orcestr-commerce-solana/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.ru.md",
    "TRADEMARKS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b",
    "prepack": "node ../../scripts/sync-package-legal.mjs core && npm run build",
    "pack:dry-run": "npm pack --dry-run"
  }
}
